  <wpt lat="58.3260763" lon="15.1310782"><name>Mjölby kyrka</name><desc>Stadens kyrka på byns högsta punkt, med ett medeltida torn som överlevde stadsbranden 1771.</desc></wpt>
  <wpt lat="58.325183333333" lon="15.139491666667"><name>Baptistkyrkan</name><desc>tidigare kyrka i Mjölby kommun, Sverige</desc></wpt>
  <wpt lat="58.33263270438524" lon="15.128283572071478"><name>Mjölby gravkapell</name><desc>Mjölbys gravkapell från 1899, ritat av Joh. Lagerström.</desc></wpt>
  <wpt lat="58.311904" lon="15.114375"><name>Mjölby 43:1</name><desc>kyrka/kapell i Östergötland</desc></wpt>
  <wpt lat="58.33366667" lon="15.02502778"><name>Hogstads kyrka</name><desc>kyrka i Mjölby kommun, Sverige</desc></wpt>
  <wpt lat="58.372155" lon="15.0052593"><name>Bjälbo kyrka</name><desc>Folkungaättens gårdskyrka och Birger jarls trakt — med ett mäktigt medeltida torn.</desc></wpt>
  <wpt lat="58.33615" lon="15.22709"><name>Sya kyrka</name><desc>kyrkobyggnad i Mjölby kommun</desc></wpt>
  <wpt lat="58.2703521" lon="15.2830875"><name>Svaneholms borgruin</name><desc>Ruinerna av en 1300-talsborg på en udde i Kilarpesjön.</desc></wpt>
