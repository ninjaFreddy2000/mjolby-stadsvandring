<gpx version="1.1" creator="Stadsvandring.io" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Kyrkostigen i Mjölby</name><link href="https://stadsvandring.io"><text>Stadsvandring.io</text></link></metadata>
  <wpt lat="58.3982617" lon="15.0827455"><name>S:ta Ingrids klosterruin</name><desc>Sveriges första kvinnliga dominikankloster.</desc></wpt>
  <wpt lat="58.3947888" lon="15.0867153"><name>Vårfrukyrkan (&#39;Garpekyrkan&#39;), Skänninge</name><desc>De tyska köpmännens mäktiga tegelkyrka — en av få stora medeltida tegelkyrkor i Östergötland.</desc></wpt>
  <wpt lat="58.3925" lon="15.085"><name>S:t Olofs kloster &amp; Petrus de Dacia</name><desc>Dominikankonventet i Skänninge där &#39;Sveriges förste författare&#39; verkade.</desc></wpt>
  <wpt lat="58.372155" lon="15.0052593"><name>Bjälbo kyrka</name><desc>Folkungaättens gårdskyrka och Birger jarls trakt — med ett mäktigt medeltida torn.</desc></wpt>
  <wpt lat="58.3260763" lon="15.1310782"><name>Mjölby kyrka</name><desc>Stadens kyrka på byns högsta punkt, med ett medeltida torn som överlevde stadsbranden 1771.</desc></wpt>
  <wpt lat="58.2703521" lon="15.2830875"><name>Svaneholms borgruin</name><desc>Ruinerna av en 1300-talsborg på en udde i Kilarpesjön.</desc></wpt>
