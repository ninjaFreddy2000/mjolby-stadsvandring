  <wpt lat="59.85881082487165" lon="17.63470420697484"><name>Bro</name><desc>En stenvalvsbro från 1759 med inhuggen årtalstavla.</desc></wpt>
  <wpt lat="59.85861111" lon="17.63611111"><name>Dombron</name><desc>bro i Uppsala, Sverige</desc></wpt>
  <wpt lat="59.85788345" lon="17.63744354"><name>Nybron, Uppsala</name><desc>bro över Fyrisån i Uppsala</desc></wpt>
  <wpt lat="59.85790493142859" lon="17.63749012303976"><name>Bro</name><desc>En valvbro av huggen granit från 1899 med balustradräcke och gjutjärnslyktor.</desc></wpt>
  <wpt lat="59.855" lon="17.641667"><name>Islandsbron</name><desc>bro i Uppsala</desc></wpt>
  <wpt lat="59.85161" lon="17.64558"><name>Hamnspången</name><desc>Hamnspången är en gång- och cykelbro i centrala Uppsala.</desc></wpt>
  <wpt lat="59.846111111111" lon="17.650833333333"><name>Tullgarnsbron</name><desc>bro över Fyrisån i Uppsala</desc></wpt>
