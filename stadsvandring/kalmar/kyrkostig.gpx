  <wpt lat="56.6764381650608" lon="16.342682517277485"><name>Heliga Korsets kapell</name><desc>Heliga Korsets kyrka och krematorium från 1961, en typisk 1960-talsanläggning i tegel och marmor.</desc></wpt>
  <wpt lat="56.67587222" lon="16.34282778"><name>Heliga Korsets kyrka</name><desc>kyrka i Kalmar</desc></wpt>
  <wpt lat="56.67465813335591" lon="16.346377537505575"><name>Norra Kapellet</name><desc>Ett kapell från 1911 på Norra kyrkogården, ritat av J F Olson i historiserande stil.</desc></wpt>
