  <wpt lat="56.663889" lon="16.359117"><name>Högvakten</name><desc>stadsbefästning i Småland (Kalmar 108:1)</desc></wpt>
  <wpt lat="56.663543724377774" lon="16.359572321835277"><name>Stadsbefästning</name><desc>En huvudvall med två bastioner där i dag ett gammalt vattentorn och ett hotell står.</desc></wpt>
  <wpt lat="56.663661" lon="16.357509"><name>Ravelinen Prins Carl</name><desc>stadsbefästning i Småland (Kalmar 62:1)</desc></wpt>
  <wpt lat="56.66447535323343" lon="16.365344594499547"><name>KALMAR DOMKYRKA</name><desc>Kalmar domkyrka, ritad av Nikodemus Tessin d.ä. och byggd från 1660.</desc></wpt>
  <wpt lat="56.66220301932542" lon="16.365648435768826"><name>Johannes Rex, Stadsbefästning</name><desc>En bastion med den kalkstensvälvda Kavaljersporten, del av Kvarnholmens 1600-talsbefästning.</desc></wpt>
  <wpt lat="56.662093" lon="16.365057"><name>Bastionen Johannes Rex</name><desc>stadsbefästning i Småland (Kalmar 52:1)</desc></wpt>
  <wpt lat="56.66525815188602" lon="16.372273291456953"><name>Bastionen Regeringen, Stadsbefästning</name><desc>En bastion i Kvarnholmens befästning, med en stensatt utsiktsplats.</desc></wpt>
  <wpt lat="56.665283" lon="16.372587"><name>Bastionen Regeringen</name><desc>stadsbefästning i Småland (Kalmar 51:1)</desc></wpt>
  <wpt lat="56.666397501984754" lon="16.371041872115654"><name>Carolus Philippus, Stadsbefästning</name><desc>En huvudvall och bastion som ingår i Kvarnholmens befästningsverk.</desc></wpt>
  <wpt lat="56.666652" lon="16.371326"><name>Carolus Philippus</name><desc>stadsbefästning i Småland (Kalmar 50:1)</desc></wpt>
  <wpt lat="56.66927010422928" lon="16.37543217051319"><name>Fästning/skans</name><desc>Kartor från 1600-talet antyder en skans på Varvsholmen, men om den verkligen byggdes är osäkert.</desc></wpt>
  <wpt lat="56.67285635689747" lon="16.375755364658325"><name>Borg</name><desc>En övertorvad vall med ett gjutjärnskors märkt AM.</desc></wpt>
  <wpt lat="56.660495" lon="16.351872"><name>Kalmar 56:2</name><desc>kyrka/kapell i Småland</desc></wpt>
  <wpt lat="56.660494573678605" lon="16.35187160602925"><name>Kyrka/kapell</name><desc>Ödekyrkogården markerar Kalmars medeltida kyrka, vars storkyrka sprängdes 1678.</desc></wpt>
  <wpt lat="56.65863" lon="16.353595"><name>Kalmar 53:2</name><desc>stadsbefästning i Småland</desc></wpt>
  <wpt lat="56.65842043381768" lon="16.353641853037903"><name>Stadsbefästning</name><desc>Kalmar slotts försvarsverk går tillbaka på en kastal från 1100-talet.</desc></wpt>
  <wpt lat="56.65802237666535" lon="16.355330635208894"><name>Borg</name><desc>Kalmar slott, ett renässansslott med rötter i en kastal från 1100-talet.</desc></wpt>
  <wpt lat="56.6575" lon="16.352222222222"><name>Dominikankonventet i Kalmar</name><desc>tidigaree kloster i Kalmar</desc></wpt>
  <wpt lat="56.656159" lon="16.350791"><name>Kalmar 59:1</name><desc>stadsbefästning i Småland</desc></wpt>
  <wpt lat="56.65604845895672" lon="16.350584232341966"><name>Stadsbefästning</name><desc>En jordbastion med stenmur som mjukt övergår i den omgivande marken.</desc></wpt>
  <wpt lat="56.65614590889413" lon="16.348983771614133"><name>Danskakullarna, Stadsbefästning</name><desc>En jordbastion med vallgrav och jordhög, känd som Danska kullarna.</desc></wpt>
  <wpt lat="56.65721" lon="16.349086"><name>Danska kullarna</name><desc>stadsbefästning i Småland (Kalmar 60:2)</desc></wpt>
  <wpt lat="56.658021" lon="16.347832"><name>Skansen</name><desc>stadsbefästning i Småland (Kalmar 54:1)</desc></wpt>
  <wpt lat="56.6583011770208" lon="16.34799958086472"><name>Sankt Erik, Stadsbefästning</name><desc>En bastion från Erik XIV:s tid, bestyckad redan 1563 och utgrävd på 1930-talet.</desc></wpt>
  <wpt lat="56.65841793815544" lon="16.347958656278216"><name>VILLA SKANSEN</name><desc>En 1883 uppförd villa av konsul Roosval, byggd på bastionen Skansens historiska mark och stilbildande för Kalmars villabyggande.</desc></wpt>
  <wpt lat="56.66125" lon="16.34497222"><name>Vasakyrkan</name><desc>kyrka i Kalmar</desc></wpt>
  <wpt lat="56.66361111" lon="16.32868333"><name>Sankt Johannes kyrka</name><desc>kyrkobyggnad i Svenska kyrkan i Kalmar, Sverige</desc></wpt>
  <wpt lat="56.65049955188249" lon="16.32607744112114"><name>Fästning/skans</name><desc>Resterna av en skans med bröstvärn och löpgrav, delvis borta genom senare markarbeten.</desc></wpt>
  <wpt lat="56.652216814124856" lon="16.370188488790983"><name>GRIMSKÄRS SKANS</name><desc>En fyrstjärnig skans från 1611 på ett skär utanför Kalmar, senare även lots- och fyrplats.</desc></wpt>
