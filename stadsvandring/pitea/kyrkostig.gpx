  <wpt lat="65.28404722" lon="21.40240833"><name>Hortlax kyrka</name><desc>kyrkobyggnad i Piteå kommun</desc></wpt>
  <wpt lat="65.284611" lon="21.399995"><name>Skogskapellet</name><desc>kapell i Hortlax, Piteå kommun</desc></wpt>
