<metadata><name>Kyrkostigen i Västervik</name><link href="https://stadsvandring.io"><text>Stadsvandring.io</text></link></metadata>
  <wpt lat="57.776765" lon="16.635613"><name>Sankt nikolai kapell</name><desc>kapell i Västerviks kommun</desc></wpt>
  <wpt lat="57.76261930323358" lon="16.642788336316702"><name>Borg</name><desc>En borgruin med rester av hörntorn och en brunn, senare plats för en smedja.</desc></wpt>
  <wpt lat="57.763071301506116" lon="16.650330088482146"><name>Fästning/skans</name><desc>En skans med fyra murpartier, möjligen knuten till borgen Stegeholm.</desc></wpt>
  <wpt lat="57.759551" lon="16.634109"><name>Sankta Gertruds kyrka, Västervik</name><desc>Stadens medeltida kyrka, byggd på 1450-talet, som efter ett halvsekel som magasin återinvigdes 1933.</desc></wpt>
  <wpt lat="57.75594167" lon="16.63821389"><name>Sankt Petri kyrka</name><desc>kyrkobyggnad i Västerviks kommun</desc></wpt>
  <wpt lat="57.755856" lon="16.638968"><name>Sankt Petri kyrka, Västervik</name><desc>Nygotisk tegelkyrka från början av 1900-talet, mäktigt placerad på terrasser ovanför staden.</desc></wpt>
  <wpt lat="57.7556" lon="16.6395"><name>Stegeholms slottsruin</name><desc>Medeltida borgruin på Slottsholmen som en gång vaktade infarten till Västervik och idag är festivalscen mitt i staden.</desc></wpt>
  <wpt lat="57.743007" lon="16.654684"><name>Johannes kapell</name><desc>kapell i Västerviks kommun</desc></wpt>
  <wpt lat="57.735724" lon="16.639676"><name>Gamla kapellet</name><desc>kapell i Västerviks kommun</desc></wpt>
  <wpt lat="57.73508208" lon="16.6366779"><name>Sankta Marias Kapell</name><desc>kapell i Västerviks kommun</desc></wpt>
