  <wpt lat="57.11641667" lon="12.263725"><name>Den gudomliga barmhärtighetens kyrka</name><desc>kyrkobyggnad i Varbergs kommun</desc></wpt>
  <wpt lat="57.11249339402504" lon="12.25317873092448"><name>Kyrka/kapell</name><desc>Ruinen efter en medeltida kyrka i Varberg, i bruk mellan 1300 och 1578.</desc></wpt>
