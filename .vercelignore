# Håll backup-/arbetsfiler borta från produktion (exponerades tidigare publikt).
# OBS: '*.bak' matchar inte '.bak2'/'.bak3' — använd '*.bak*' så numrerade backuper också fångas.
*.bak*
data.json.pre-slott
.orter-raw.json
.DS_Store

# Källdatan. Appen läser data/cities.json + data/city/*.json (byggs av
# scripts/build-data.mjs). data.json är 9,6 MB och behöver inte ligga i prod.
data.json
data.json.merged

# Förhandsgranskade artikelutkast — aldrig till produktion.
*.preview.html

# Spanarens arbetsmaterial: uppslag, research och ej godkända artikelutkast.
# Interna dokument — får inte ligga publikt (jfr backup-filerna som exponerades).
spanare/

# Bloggens källdata. Appen serverar den renderade HTML:en, inte JSON:en.
blogg/_posts/
blogg/_legacy.json
blogg/_index.json

# Arbetsmaterial för bilder (källfiler, exportunderlag). Aldrig till produktion.
_imgwork/
